# ==============================================================================
# YourTech Solutions — Environment Variables Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/yourtech_db?schema=public"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max 100 requests per IP per window
ENQUIRY_RATE_LIMIT_MAX=10    # Max 10 enquiry submissions per IP per 15 minutes

# Email Notification Service (SMTP / AWS SES / Gmail)
# If left empty, enquiries will still be saved to the database without throwing errors.
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
NOTIFICATION_FROM="YourTech Solutions <no-reply@yourtechsolutions.com>"
NOTIFICATION_TO="contact@yourtechsolutions.com"

# Optional: Admin Secret Key for API inspection
ADMIN_API_KEY="your_super_secret_admin_key_here"
